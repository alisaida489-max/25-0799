<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Saida Ali Profile</title>

  <style>
    body {
      font-family: Arial;
      background: #e6f2ff;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 10px;
      width: 300px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
      text-align: center;
    }

    input {
      width: 100%;
      padding: 8px;
      margin: 8px 0;
    }

    button {
      width: 100%;
      padding: 10px;
      background: #0a2f44;
      color: white;
      border: none;
    }
  </style>
</head>
<body>

<div class="card">
  <h2>User Profile</h2>

  <form method="POST">
    <input type="text" name="firstname" value="Saida" required>
    <input type="text" name="lastname" value="Ali" required>
    <input type="email" name="email" value="alisaida489@gmail.com" required>
    <input type="password" name="password" value="12345" required>

    <button type="submit">Save</button>
  </form>
</div>

</body>
</html>
